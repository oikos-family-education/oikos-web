{
  "name": "@oikos/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Oikos desktop app: runs PostgreSQL, the API and the web server locally",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node scripts/dev-resources.mjs && electron .",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "async-exit-hook": "^2.0.1",
    "embedded-postgres": "16.14.0-beta.17"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "pg": "^8.7.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
